{
  "name": "gather-studio",
  "version": "1.0.0",
  "description": "The conversation studio: multi-party WebRTC with a recordable stage",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "esbuild src/mood-chart.jsx --bundle --format=esm --target=es2022 --minify --outfile=public/mood-chart.js && node scripts/check.js",
    "build:charts": "esbuild src/mood-chart.jsx --bundle --format=esm --target=es2022 --minify --outfile=public/mood-chart.js",
    "lint": "node scripts/check.js",
    "test": "node tests/run.js",
    "check": "node scripts/check.js",
    "audit": "node scripts/audit.ts",
    "bench": "node scripts/fx-bench.ts",
    "fx:live": "node scripts/fx-live.ts",
    "ui-kit": "node scripts/ui-kit.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "esbuild": "^0.28.2",
    "ioredis": "5.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "recharts": "^3.11.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright": "1.63.0",
    "typescript": "6.0.2"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0"
  }
}
